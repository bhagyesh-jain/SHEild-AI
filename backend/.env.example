# ──────────────────────────────────────────────────────────────────────────────
# SHEild AI 2.0 — Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# General
PROJECT_NAME="SHEild AI 2.0"
API_V1_STR="/api/v1"
APP_ENV="development"
# Optional JSON list of browser origins, e.g. CORS_ORIGINS='["https://example.edu"]'
# Empty/omitted uses localhost origins in development and denies browser origins elsewhere.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (e.g. https://xxxxxxxxxxx.supabase.co)
SUPABASE_URL=""
# Anon public key (safe to use in server-side code with RLS enforced)
SUPABASE_KEY=""

# JWT verification
# For Supabase hosted: leave SUPABASE_JWT_SECRET blank and set SUPABASE_JWKS_URL
# For local Supabase CLI: set SUPABASE_JWT_SECRET from `supabase status`
SUPABASE_JWT_SECRET=""
SUPABASE_JWKS_URL=""          # https://<project-ref>.supabase.co/auth/v1/keys
SUPABASE_JWT_ISSUER=""        # https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=""      # authenticated

# ── Database ──────────────────────────────────────────────────────────────────
# Direct Postgres URL (used by migrations/scripts, not FastAPI)
DATABASE_URL=""

# ── Alert Provider ────────────────────────────────────────────────────────────
ALERT_PROVIDER="mock"         # mock only; no external provider is configured

# ── Location Retention ────────────────────────────────────────────────────────
LOCATION_RETENTION_HOURS=48
